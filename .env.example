# ==============================================================================
# MovieTicket Application - Environment Configuration Template
# Copy this file to .env and configure your secrets before deploying.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
PORT=8080

# ------------------------------------------------------------------------------
# 2. Database Configuration (MySQL / Cloud Database)
# ------------------------------------------------------------------------------
# For Docker Compose / Local MySQL:
MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_DATABASE=movieticket

# For Cloud Managed DB (Aiven / Railway / Supabase / AWS RDS):
# SPRING_DATASOURCE_URL=jdbc:mysql://<HOST>:<PORT>/<DATABASE_NAME>?createDatabaseIfNotExist=true&useSSL=true&allowPublicKeyRetrieval=true
# SPRING_DATASOURCE_USERNAME=avnadmin
# SPRING_DATASOURCE_PASSWORD=your_cloud_db_password

# ------------------------------------------------------------------------------
# 3. Spring Mail (Gmail SMTP for OTP & Booking Confirmation Emails)
# ------------------------------------------------------------------------------
# Note: For Gmail, generate a 16-character App Password at https://myaccount.google.com/apppasswords
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_gmail_address@gmail.com
SPRING_MAIL_PASSWORD=your_16_char_gmail_app_password

# ------------------------------------------------------------------------------
# 4. Security & JWT Configuration
# ------------------------------------------------------------------------------
# Generate a 256-bit (64 hex characters) secret key
APP_JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
APP_JWT_EXPIRATION_MS=86400000
# Comma-separated list of allowed frontend origins for CORS
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend-domain.vercel.app

# ------------------------------------------------------------------------------
# 5. TMDB API (The Movie Database - https://www.themoviedb.org/settings/api)
# ------------------------------------------------------------------------------
TMDB_API_KEY=your_tmdb_v3_api_key

# ------------------------------------------------------------------------------
# 6. Razorpay Payment Gateway (https://dashboard.razorpay.com/)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ------------------------------------------------------------------------------
# 7. SMS OTP Gateways (Fast2SMS for India / Twilio International)
# ------------------------------------------------------------------------------
FAST2SMS_API_KEY=your_fast2sms_api_key
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_FROM_NUMBER=+1234567890

# ------------------------------------------------------------------------------
# 8. Frontend Build / Runtime Variables
# ------------------------------------------------------------------------------
# Set to your deployed backend URL on Vercel / Netlify (e.g. https://your-backend.onrender.com)
# Set to /api for Docker Compose Nginx reverse proxy
VITE_API_BASE_URL=http://localhost:8080
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
